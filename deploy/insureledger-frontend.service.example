# Replace paths/user and verify /usr/bin/npm on the client host.
[Unit]
Description=InsureLedger frontend
After=network.target

[Service]
Type=simple
User=insureledger
Group=insureledger
WorkingDirectory=/srv/insureledger/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
